test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# Reference document, not a build input
Befoerderungsvertrag.pdf

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Subagent-driven-development scratch (progress ledger, not project artifacts)
.superpowers/
